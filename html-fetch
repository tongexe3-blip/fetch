<script>
(function() {
  'use strict';
  
  let students = [];
  let studentIDCounter = 0;
  
  const classSelect = document.getElementById('class-select');
  const showClass = document.getElementById('show-class');
  const tableBody = document.getElementById('table-body');
  const importInput = document.getElementById('import-input');
  
  // Function to get full class name
  function getFullClassName(classCode) {
    const classNames = {
      '2K': 'មត្តេយ្យចម្រុះ',
      '3K': 'មត្តេយ្យខ្ពស់',
      '1A': '១ក',
      '1B': '១ខ',
      '2A': '២ក',
      '2B': '២ខ',
      '3A': '៣ក',
      '3B': '៣ខ',
      '4A': '៤ក',
      '4B': '៤ខ',
      '5A': '៥ក',
      '5B': '៥ខ',
      '6A': '៦ក',
      '6B': '៦ខ'
    };
    return classNames[classCode] || classCode;
  }
  
  function calculateAge(birthdateStr) {
    if(!birthdateStr) return '';
    const parts = birthdateStr.split(/[\/\-\.]/);
    if(parts.length !== 3) return '';
    let day, month, year;
    
    // Check if format is MM-DD-YYYY or DD/MM/YYYY
    if(birthdateStr.includes('-')) {
      month = parseInt(parts[0], 10) - 1;
      day = parseInt(parts[1], 10);
      year = parseInt(parts[2], 10);
    } else {
      day = parseInt(parts[0], 10);
      month = parseInt(parts[1], 10) - 1;
      year = parseInt(parts[2], 10);
    }
    
    const birthDate = new Date(year, month, day);
    const today = new Date();
    let age = today.getFullYear() - birthDate.getFullYear();
    const m = today.getMonth() - birthDate.getMonth();
    if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) {
      age--;
    }
    return age;
  }
  
  function renderTable() {
    const filterClass = classSelect.value;
    const fullClassName = filterClass ? getFullClassName(filterClass) : 'ទាំងអស់';
    showClass.textContent = fullClassName;
    
    tableBody.innerHTML = '';
    
    let filtered = filterClass ? students.filter(s => s.class === filterClass) : students;
    
    filtered.forEach((s, idx) => {
      const age = calculateAge(s.dob);
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td>${idx+1}</td>
        <td contenteditable="true" class="editable" data-field="studentId" data-id="${s.id}">${s.studentId || ''}</td>
        <td contenteditable="true" class="editable align-left" data-field="name" data-id="${s.id}">${s.name}</td>
        <td class="hide-on-print" contenteditable="true" class="editable" data-field="class" data-id="${s.id}">${s.class}</td>
        <td>
          <select class="gender-select" data-field="gender" data-id="${s.id}">
            <option value="ប្រុស" ${s.gender === 'ប្រុស' ? 'selected' : ''}>ប្រុស</option>
            <option value="ស្រី" ${s.gender === 'ស្រី' ? 'selected' : ''}>ស្រី</option>
          </select>
        </td>
        <td contenteditable="true" class="editable" data-field="dob" data-id="${s.id}">${s.dob}</td>
        <td>${age}</td>
        <td><input type="checkbox" data-field="newStudent" data-id="${s.id}" ${s.newStudent ? 'checked' : ''}></td>
        <td><input type="checkbox" data-field="repeatStudent" data-id="${s.id}" ${s.repeatStudent ? 'checked' : ''}></td>
        <td><input type="checkbox" data-field="fatherOrphan" data-id="${s.id}" ${s.fatherOrphan ? 'checked' : ''}></td>
        <td><input type="checkbox" data-field="motherOrphan" data-id="${s.id}" ${s.motherOrphan ? 'checked' : ''}></td>
        <td><input type="checkbox" data-field="bothOrphan" data-id="${s.id}" ${s.bothOrphan ? 'checked' : ''}></td>
        <td><input type="checkbox" data-field="disabled" data-id="${s.id}" ${s.disabled ? 'checked' : ''}></td>
        <td><input type="checkbox" data-field="poor" data-id="${s.id}" ${s.poor ? 'checked' : ''}></td>
        <td class="row-actions">
          <button class="delete-btn" data-id="${s.id}" title="លុប">❌</button>
        </td>
      `;
      tableBody.appendChild(tr);
    });
    
    attachEventListeners();
    updateStatistics(filtered);
  }
  
  function attachEventListeners() {
    document.querySelectorAll('.editable').forEach(el => {
      el.addEventListener('blur', function() {
        const id = parseInt(this.getAttribute('data-id'));
        const field = this.getAttribute('data-field');
        const value = this.textContent.trim();
        const student = students.find(s => s.id === id);
        if(student) {
          student[field] = value;
          if(field === 'dob') renderTable();
        }
      });
    });
    
    document.querySelectorAll('.gender-select').forEach(el => {
      el.addEventListener('change', function() {
        const id = parseInt(this.getAttribute('data-id'));
        const student = students.find(s => s.id === id);
        if(student) {
          student.gender = this.value;
          renderTable();
        }
      });
    });
    
    document.querySelectorAll('input[type="checkbox"]').forEach(el => {
      el.addEventListener('change', function() {
        const id = parseInt(this.getAttribute('data-id'));
        const field = this.getAttribute('data-field');
        const student = students.find(s => s.id === id);
        if(student) {
          student[field] = this.checked;
        }
      });
    });
    
    document.querySelectorAll('.delete-btn').forEach(el => {
      el.addEventListener('click', function() {
        const id = parseInt(this.getAttribute('data-id'));
        if(confirm('តើអ្នកប្រាកដចង់លុបសិស្សនេះ?')) {
          students = students.filter(s => s.id !== id);
          renderTable();
        }
      });
    });
  }
  
  function updateStatistics(filtered) {
    const total = filtered.length;
    const totalFemale = filtered.filter(s => s.gender === 'ស្រី').length;
    
    document.getElementById('sum-total').textContent = total;
    document.getElementById('sum-total-female').textContent = totalFemale;
    
    // Calculate age groups
    const ageGroups = {};
    filtered.forEach(s => {
      const age = calculateAge(s.dob);
      if(age && age >= 2 && age <= 16) {
        if(!ageGroups[age]) {
          ageGroups[age] = { total: 0, female: 0 };
        }
        ageGroups[age].total++;
        if(s.gender === 'ស្រី') {
          ageGroups[age].female++;
        }
      }
    });
    
    // Split ages into 3 columns
    const ages = Object.keys(ageGroups).map(Number).sort((a, b) => a - b);
    const itemsPerColumn = Math.ceil(ages.length / 3);
    
    let col1HTML = '<div class="age-column">';
    let col2HTML = '<div class="age-column">';
    let col3HTML = '<div class="age-column">';
    
    ages.forEach((age, idx) => {
      const line = `<div>អាយុ ${age} ឆ្នាំ សរុបចំនួន <strong>${ageGroups[age].total}</strong> នាក់ ស្រី <strong>${ageGroups[age].female}</strong> នាក់</div>`;
      
      if(idx < itemsPerColumn) {
        col1HTML += line;
      } else if(idx < itemsPerColumn * 2) {
        col2HTML += line;
      } else {
        col3HTML += line;
      }
    });
    
    col1HTML += '</div>';
    col2HTML += '</div>';
    col3HTML += '</div>';
    
    document.getElementById('age-breakdown').innerHTML = col1HTML + col2HTML + col3HTML;
  }
  
  function addNewStudent() {
    const className = classSelect.value || '1A';
    const newStudent = {
      id: studentIDCounter++,
      studentId: '',
      name: '',
      class: className,
      gender: 'ប្រុស',
      dob: '',
      newStudent: false,
      repeatStudent: false,
      fatherOrphan: false,
      motherOrphan: false,
      bothOrphan: false,
      disabled: false,
      poor: false
    };
    students.push(newStudent);
    renderTable();
  }
  
  function exportCSV() {
    const header = 'ល.រ,អត្តលេខ,គោត្តនាម-នាម,ថ្នាក់,ភេទ,ថ្ងៃខែឆ្នាំកំណើត,អាយុ,សិស្សថ្មី,សិស្សចាស់,កំព្រាឪពុក,កំព្រាម្ដាយ,កំព្រាឪពុកម្ដាយ,ពិការ,ក្រីក្រ\n';
    let csvRows = [header];
    
    students.forEach((s, idx) => {
      const row = [
        idx + 1,
        s.studentId || '',
        `"${s.name}"`,
        s.class,
        s.gender,
        s.dob,
        calculateAge(s.dob),
        s.newStudent ? '1' : '0',
        s.repeatStudent ? '1' : '0',
        s.fatherOrphan ? '1' : '0',
        s.motherOrphan ? '1' : '0',
        s.bothOrphan ? '1' : '0',
        s.disabled ? '1' : '0',
        s.poor ? '1' : '0'
      ].join(',');
      csvRows.push(row);
    });
    
    const csvString = '\uFEFF' + csvRows.join('\n');
    const blob = new Blob([csvString], {type:'text/csv;charset=utf-8;'});
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'បញ្ជីសិស្ស_' + new Date().toISOString().split('T')[0] + '.csv';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  }
  
  function clearTable() {
    if(confirm('តើអ្នកប្រាកដចង់លុបទិន្នន័យសិស្សទាំងអស់?')) {
      students = [];
      studentIDCounter = 0;
      renderTable();
    }
  }
  
  // Event Listeners
  document.getElementById('addBtn').addEventListener('click', addNewStudent);
  document.getElementById('loadBtn').addEventListener('click', function() {
    importInput.click();
  });
  document.getElementById('saveBtn').addEventListener('click', exportCSV);
  document.getElementById('clearBtn').addEventListener('click', clearTable);
  document.getElementById('printBtn').addEventListener('click', function() {
    window.print();
  });
  classSelect.addEventListener('change', renderTable);
  importInput.addEventListener('change', function(e) {
    const file = e.target.files[0];
    if(!file) return;
    
    Papa.parse(file, {
      header: true,
      skipEmptyLines: true,
      encoding: 'UTF-8',
      complete: function(results) {
        results.data.forEach(row => {
          const student = {
            id: studentIDCounter++,
            studentId: row['អត្តលេខ'] || row['StudentId'] || '',
            name: row['គោត្តនាម-នាម'] || row['Name'] || '',
            class: row['ថ្នាក់'] || row['Class'] || '1A',
            gender: row['ភេទ'] || row['Gender'] || 'ប្រុស',
            dob: row['ថ្ងៃខែឆ្នាំកំណើត'] || row['DOB'] || '',
            newStudent: (row['សិស្សថ្មី'] || row['NewStudent'] || '0') === '1',
            repeatStudent: (row['សិស្សចាស់'] || row['RepeatStudent'] || '0') === '1',
            fatherOrphan: (row['កំព្រាឪពុក'] || row['FatherOrphan'] || '0') === '1',
            motherOrphan: (row['កំព្រាម្ដាយ'] || row['MotherOrphan'] || '0') === '1',
            bothOrphan: (row['កំព្រាឪពុកម្ដាយ'] || row['BothOrphan'] || '0') === '1',
            disabled: (row['ពិការ'] || row['Disabled'] || '0') === '1',
            poor: (row['ក្រីក្រ'] || row['Poor'] || '0') === '1'
          };
          students.push(student);
        });
        renderTable();
      },
      error: function(err) {
        alert('Error loading CSV file: ' + err.message);
      }
    });
  });

  // Initial render
  renderTable();
})();
</script>
